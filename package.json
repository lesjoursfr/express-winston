{
	"name": "@lesjoursfr/express-winston",
	"version": "4.2.0",
	"description": "express.js middleware for winstonjs/winston",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lesjoursfr/express-winston.git"
	},
	"homepage": "https://github.com/lesjoursfr/express-winston#readme",
	"bugs": {
		"url": "https://github.com/lesjoursfr/express-winston/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": "22.x || 24.x || 26.x"
	},
	"keywords": [
		"winston",
		"logging",
		"express",
		"log",
		"error",
		"handler",
		"middleware",
		"colors"
	],
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"type": "module",
	"scripts": {
		"freshlock": "rm -rf node_modules/ && rm .yarn/install-state.gz && rm yarn.lock && yarn",
		"check-lint": "eslint",
		"check-format": "prettier --check .",
		"check-tsc": "tsc --noEmit",
		"lint": "eslint --fix",
		"format": "prettier --write .",
		"build": "tsc -p tsconfig.build.json",
		"test": "NODE_OPTIONS='--loader=ts-node/esm' mocha"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"lodash": "^4.18.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tsconfig/node22": "22.0.5",
		"@types/express": "5.0.6",
		"@types/lodash": "4.17.24",
		"@types/mocha": "10.0.10",
		"@types/node": "24.12.4",
		"eslint": "10.3.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.6.0",
		"mocha": "11.7.5",
		"prettier": "3.8.3",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.59.3",
		"winston": "3.19.0",
		"winston-transport": "4.9.0"
	},
	"peerDependencies": {
		"express": "^5.2.1",
		"winston": "^3.19.0"
	},
	"packageManager": "yarn@4.14.1"
}
